---
import { contact, needOptions } from '../data/content.js';
---
<section id="contact" class="sec sec-dark contact" data-webhook={contact.webhook}>
  <div class="wrap contact-grid">
    <div class="contact-copy">
      <p class="eyebrow r"><span class="t-label">Liên Hệ</span></p>
      <h2 class="t-h2 r">Hồ Sơ Đang Chờ? <span class="gold">Gửi Cho Chúng Tôi.</span></h2>
      <p class="contact-sub t-lead r">
        Phản hồi thẩm định ban đầu trong 24h — miễn phí, không ràng buộc.
      </p>
      <div class="contact-direct r">
        <a href={contact.emailHref} class="contact-link">
          <span class="cl-ic" aria-hidden="true">✉</span>
          <span><b>Gửi Hồ Sơ Email</b><em>{contact.email}</em></span>
        </a>
        <a href={contact.phoneHref} class="contact-link">
          <span class="cl-ic" aria-hidden="true">✆</span>
          <span><b>Gọi {contact.phone}</b><em>{contact.city}</em></span>
        </a>
      </div>
    </div>

    <form class="contact-form r" id="lead-form" novalidate>
      <div class="field">
        <label for="cf-name">Họ và tên <span aria-hidden="true">*</span></label>
        <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Nguyễn Văn A" />
      </div>
      <div class="field">
        <label for="cf-phone">Số điện thoại <span aria-hidden="true">*</span></label>
        <input id="cf-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="09xx xxx xxx" />
      </div>
      <div class="field">
        <label for="cf-need">Nhu cầu <span aria-hidden="true">*</span></label>
        <div class="select-wrap">
          <select id="cf-need" name="need" required>
            <option value="" disabled selected>Chọn dịch vụ</option>
            {needOptions.map((o) => (<option value={o}>{o}</option>))}
          </select>
        </div>
      </div>
      <button id="cf-btn" class="btn btn-gold cf-btn" type="submit">Gửi Yêu Cầu Thẩm Định <span class="arw">→</span></button>
      <p id="cf-msg" class="cf-msg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(36px, 5vw, 72px); align-items: center; }
  .contact-sub { color: var(--mh); margin: 18px 0 30px; }
  .contact-direct { display: grid; gap: 14px; }
  .contact-link {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px; border: 1px solid var(--dd); border-radius: var(--r-md);
    transition: border-color var(--dur-2), background var(--dur-2), transform var(--dur-2) var(--ease);
  }
  .contact-link:hover { border-color: var(--gl); background: var(--g100); transform: translateX(4px); }
  .cl-ic {
    width: 40px; height: 40px; flex-shrink: 0; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--g200); color: var(--g400); font-size: 17px; border: 1px solid var(--gl);
  }
  .contact-link b { display: block; color: var(--w); font-size: 15px; }
  .contact-link em { display: block; color: var(--ml); font-size: 13px; font-style: normal; margin-top: 2px; }

  .contact-form {
    background: linear-gradient(165deg, rgba(18,34,74,.7), rgba(9,20,44,.75));
    border: 1px solid var(--gl); border-radius: var(--r-lg);
    padding: clamp(26px, 3.4vw, 38px);
    box-shadow: var(--sh-3); display: grid; gap: 18px;
  }
  .field { display: grid; gap: 8px; }
  .field label { font: 500 13px 'DM Sans', sans-serif; color: var(--ml); }
  .field label span { color: var(--g500); }
  .field input, .field select {
    width: 100%; padding: 14px 16px; min-height: 50px;
    background: rgba(6,16,42,.5); border: 1px solid var(--dd); border-radius: var(--r-sm);
    color: var(--w); font-size: 15px;
    transition: border-color var(--dur-2), box-shadow var(--dur-2);
  }
  .field input::placeholder { color: #5E7093; }
  .field input:focus, .field select:focus {
    outline: none; border-color: var(--g500); box-shadow: 0 0 0 3px var(--g100);
  }
  .select-wrap { position: relative; }
  .select-wrap::after {
    content: '▾'; position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
    color: var(--g400); pointer-events: none; font-size: 12px;
  }
  .field select { appearance: none; cursor: pointer; }
  .field select option { background: #0B1739; color: var(--w); }
  .cf-btn { margin-top: 6px; width: 100%; }
  .cf-btn:disabled { opacity: .6; cursor: wait; }
  .cf-msg { font-size: 13.5px; min-height: 20px; line-height: 1.5; }

  @media (max-width: 900px) { .contact-grid { grid-template-columns: 1fr; } }
</style>
