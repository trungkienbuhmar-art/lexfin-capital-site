---
import { processSteps } from '../data/content.js';
---
<section id="process" class="sec sec-dark process">
  <div class="wrap">
    <div class="sec-hd">
      <p class="eyebrow"><span class="t-label">Quy Trình LexFin</span></p>
      <h2 class="t-h2">Từ Hồ Sơ, <span class="gold">Đến Deal Chốt.</span></h2>
    </div>

    <ol class="proc-list">
      {processSteps.map((p) => (
        <li class="proc-row r">
          <span class="proc-no mono">{p.no}</span>
          <div class="proc-main">
            <span class="proc-tag mono">{p.tag}</span>
            <h3 class="t-h3">{p.title}</h3>
          </div>
          <p class="proc-desc">{p.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .proc-list { list-style: none; }
  .proc-row {
    display: grid; grid-template-columns: 88px 1fr 1.1fr; gap: clamp(20px, 4vw, 56px);
    align-items: start;
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--dd);
  }
  .proc-row:last-child { border-bottom: 1px solid var(--dd); }
  .proc-no {
    font-size: clamp(34px, 4vw, 48px); font-weight: 300; line-height: 1;
    color: transparent; -webkit-text-stroke: 1px var(--gl);
  }
  .proc-tag {
    display: inline-block; font-size: 11px; letter-spacing: .1em; color: var(--g400);
    background: var(--g100); border: 1px solid var(--gl); border-radius: 100px;
    padding: 6px 12px; margin-bottom: 14px;
  }
  .proc-main h3 { color: var(--w); }
  .proc-desc { color: var(--mh); font-size: 15px; line-height: 1.8; }

  @media (max-width: 860px) {
    .proc-row { grid-template-columns: 1fr; gap: 14px; }
    .proc-no { font-size: 30px; -webkit-text-stroke: 1px var(--g500); color: transparent; }
  }
</style>
