---
import { navLinks } from '../data/content.js';
---
<nav id="nav" class="nav at-top" aria-label="Điều hướng chính">
  <div class="nav-in">
    <a href="#top" class="logo" aria-label="LexFin Capital — trang chủ">
      <img src="/img/logo.png" alt="LexFin Capital" width="132" height="34" />
    </a>

    <ul class="nav-links">
      {navLinks.map((l) => (
        <li><a href={l.href}>{l.label}</a></li>
      ))}
    </ul>

    <div class="nav-right">
      <a href="#contact" class="btn btn-gold nav-cta">Thẩm Định 24h <span class="arw">→</span></a>
      <button id="ham" class="ham" aria-label="Mở menu" aria-expanded="false" aria-controls="mob">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div id="mob" class="mob" aria-hidden="true">
  <ul>
    {navLinks.map((l) => (<li><a href={l.href} data-close>{l.label}</a></li>))}
  </ul>
  <a href="#contact" class="btn btn-gold" data-close>Thẩm Định Hồ Sơ 24h <span class="arw">→</span></a>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 300;
    height: var(--nav-h);
    display: flex; align-items: center;
    transition: background var(--dur-2) var(--ease), border-color var(--dur-2), box-shadow var(--dur-2);
    border-bottom: 1px solid transparent;
  }
  .nav-in {
    width: 100%; max-width: var(--maxw); margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .logo img { height: 34px; width: auto; transition: filter var(--dur-2); }

  .nav-links {
    display: flex; gap: 34px; list-style: none;
    position: absolute; left: 50%; transform: translateX(-50%);
  }
  .nav-links a {
    font: 400 13px 'Manrope', system-ui, sans-serif; letter-spacing: .04em;
    color: var(--ml); position: relative; padding-block: 6px;
    transition: color var(--dur-2);
  }
  .nav-links a::after {
    content: ''; position: absolute; left: 0; bottom: 0; height: 1.5px; width: 0;
    background: var(--g500); transition: width var(--dur-2) var(--ease);
  }
  .nav-links a:hover { color: var(--w); }
  .nav-links a:hover::after { width: 100%; }

  .nav-right { display: flex; align-items: center; gap: 14px; }
  .nav-cta { padding: 11px 22px; min-height: 42px; font-size: 11.5px; }

  /* States */
  .nav.at-top { background: transparent; }
  .nav.scrolled {
    background: rgba(8, 20, 44, .82);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    border-bottom-color: var(--gl);
    box-shadow: 0 8px 30px rgba(6,16,42,.28);
  }
  .nav.light {
    background: rgba(250, 250, 247, .9);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    border-bottom-color: var(--dl);
    box-shadow: 0 6px 24px rgba(6,16,42,.08);
  }
  .nav.light .logo img { filter: none; }
  .nav.light .nav-links a { color: var(--m); }
  .nav.light .nav-links a:hover { color: var(--ink); }
  .nav.light .ham span { background: var(--ink); }

  /* Hamburger */
  .ham { display: none; width: 44px; height: 44px; flex-direction: column;
    align-items: center; justify-content: center; gap: 5px; }
  .ham span { width: 22px; height: 2px; background: var(--w); border-radius: 2px;
    transition: transform var(--dur-2) var(--ease), opacity var(--dur-1); }
  .ham.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .ham.open span:nth-child(2) { opacity: 0; }
  .ham.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .mob {
    position: fixed; inset: var(--nav-h) 0 auto 0; z-index: 290;
    background: rgba(9, 22, 48, .98);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid var(--gl);
    padding: 24px var(--gutter) 34px;
    display: flex; flex-direction: column; gap: 6px;
    transform: translateY(-14px); opacity: 0; visibility: hidden; pointer-events: none;
    transition: transform var(--dur-2) var(--ease), opacity var(--dur-2), visibility var(--dur-2);
  }
  .mob.open { transform: none; opacity: 1; visibility: visible; pointer-events: auto; }
  .mob ul { list-style: none; }
  .mob li a {
    display: block; padding: 15px 4px;
    font: 500 17px 'Manrope', system-ui, sans-serif; color: var(--ml);
    border-bottom: 1px solid var(--dd);
  }
  .mob li a:active { color: var(--g400); }
  .mob .btn { margin-top: 20px; width: 100%; }

  @media (max-width: 980px) {
    .nav-links { display: none; }
    .nav-cta { display: none; }
    .ham { display: flex; }
  }
</style>
